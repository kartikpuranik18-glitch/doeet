rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isCompanyManager(companyId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)).data.role
          in ['owner', 'admin', 'recruiter'];
    }

    function hasAnyRole(roles) {
      return request.auth != null && request.auth.token.roles != null
        && request.auth.token.roles.hasAny(roles);
    }

    function hasValidWorkspaceSelection() {
      return request.resource.data.activeWorkspace == 'learner'
        || (request.resource.data.activeWorkspace == 'company'
          && request.resource.data.roles.hasAny([
            'employer', 'recruiter', 'agency', 'institution', 'company_admin'
          ]))
        || (request.resource.data.activeWorkspace == 'administration'
          && request.resource.data.roles.hasAny(['platform_admin']));
    }

    // ── Users ──────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // New accounts begin as learners. Elevated roles are granted by an
      // Admin SDK workflow which also sets Firebase custom claims.
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.roles == ['learner']
        && hasValidWorkspaceSelection();
      allow update: if request.auth != null && request.auth.uid == userId
        && hasValidWorkspaceSelection()
        && (
          request.resource.data.roles == resource.data.roles
          || (!('roles' in resource.data)
              && request.resource.data.roles == ['learner'])
        );
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Daily stats sub-collection
      match /dailyStats/{dateKey} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Courses ────────────────────────────────────────────────────────────
    match /users/{userId}/courses/{courseId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Video progress sub-collection
      match /videos/{videoId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Notes ──────────────────────────────────────────────────────────────
    match /users/{userId}/notes/{noteId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Tasks and progress belong to a single authenticated user.
    match /users/{userId}/tasks/{taskId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 240
        && request.resource.data.dueAt is timestamp
        && request.resource.data.isCompleted is bool;
    }

    match /users/{userId}/goals/{goalId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 180
        && request.resource.data.progress is int
        && request.resource.data.progress >= 0
        && request.resource.data.target is int
        && request.resource.data.target > 0;
    }

    match /users/{userId}/habits/{habitId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.completedDates is list;
    }

    // Only this deliberately public projection is used by the leaderboard.
    // Private account fields remain in users/{userId} and are never exposed.
    match /leaderboard/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'photoURL', 'xp', 'level', 'streak'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.xp is int
        && request.resource.data.level is int
        && request.resource.data.streak is int;
      allow delete: if false;
    }

    // ── Career data ────────────────────────────────────────────────────────
    // A learner owns their profile, resume drafts, projects and applications.
    // Shared/public projections must be written by a trusted backend after the
    // user explicitly chooses to publish them.
    match /users/{userId}/{collection}/{documentId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && collection in [
          'careerProfiles', 'resumes', 'portfolios', 'projects',
          'applications', 'savedJobs', 'certificates', 'skillEvidence',
          'careerRoadmaps', 'interviewPractice', 'notifications'
        ];
    }

    // ── Company / recruiter data ───────────────────────────────────────────
    // Company membership is deliberately separate from personal learner data.
    // The membership document is server-created after verification.
    match /companies/{companyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && hasAnyRole(['employer', 'company_admin']);
      allow update, delete: if isCompanyManager(companyId);

      match /members/{memberId} {
        allow read: if request.auth != null &&
          (request.auth.uid == memberId || isCompanyManager(companyId));
        allow write: if false; // Admin SDK / verified server workflow only.
      }

      match /jobs/{jobId} {
        allow read: if request.auth != null;
        allow create, update, delete: if isCompanyManager(companyId);
      }

      match /applications/{applicationId} {
        allow read, update: if isCompanyManager(companyId);
        allow create, delete: if false; // submitted via validated backend flow
      }

      match /candidates/{candidateId} {
        allow read: if isCompanyManager(companyId);
        allow write: if false; // derived, consented projection only
      }
    }

    // Public certificate verification never exposes the user's private profile.
    // Issuance is intentionally server-only after server-side completion checks.
    match /certificateVerifications/{certificateId} {
      allow read: if true;
      allow write: if false;
    }

    match /platform/{document=**} {
      allow read, write: if request.auth != null
        && hasAnyRole(['platform_admin']);
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
